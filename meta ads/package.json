{
  "name": "meta-ads-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-page Meta Ads Manager demo (MERN)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "seed": "node server/seed.js --reset"
  },
  "dependencies": {
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "mongodb-memory-server": "^10.1.2"
  }
}
