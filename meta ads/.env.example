PORT=5000
# MongoDB (Atlas or VPS). Leave empty to use a throw-away in-memory DB (dev only).
MONGO_URI=
# Cloudinary (leave empty to store uploads on local disk in server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Auto-create demo data when the database is empty
SEED_ON_EMPTY=true
# Cloudinary media folder (created automatically)
CLOUDINARY_FOLDER=meta-ads-manager-demo

# Admin login (required in production)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
SESSION_SECRET=
DEMO_EMAIL=
DEMO_PASSWORD=
